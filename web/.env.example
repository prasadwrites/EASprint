# EASprint runs without any of this: with no Firebase config, progress is kept in this browser.
# To sync progress across devices, copy this file to .env.local and fill in the web app config
# from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to true to talk to the local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATORS=false
