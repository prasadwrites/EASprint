rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }
    // Keep in step with ADMIN_EMAIL in functions/accounts.py and web/src/lib/account.ts.
    function isAdmin() {
      return signedIn() && request.auth.token.email == "prasad.writes@gmail.com" && request.auth.token.email_verified == true;
    }
    function accountPath() { return /databases/$(database)/documents/accounts/$(request.auth.uid); }
    function sharedWithMe(data) {
      return signedIn() && request.auth.uid in data.get("sharedWith", []);
    }
    function notSuspended() {
      return !exists(accountPath()) || get(accountPath()).data.status != "suspended";
    }

    // One account per person. It is created on first sign-in with the Free plan; only the admin
    // (through the admin_update_account function) can change the plan, status or deck count.
    match /accounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Terms of Use acceptance: the version is a short string and the time is the server's own clock.
      function validTerms(d) {
        return !("termsVersion" in d) || (d.termsVersion is string && d.termsVersion.size() <= 20 && d.termsAcceptedAt == request.time);
      }
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["email", "displayName", "plan", "status", "decksCreated", "createdAt", "lastSeenAt", "termsVersion", "termsAcceptedAt"])
        && request.resource.data.plan == "free"
        && request.resource.data.status == "active"
        && request.resource.data.decksCreated == 0
        && request.resource.data.email == request.auth.token.email
        && ("termsVersion" in request.resource.data) == ("termsAcceptedAt" in request.resource.data)
        && validTerms(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSeenAt", "displayName"])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["termsVersion", "termsAcceptedAt"])
          && request.resource.data.termsVersion is string && request.resource.data.termsVersion.size() <= 20
          && request.resource.data.termsAcceptedAt == request.time));
    }

    // Per-account access codes for building decks. Only the admin can read them, so nobody can
    // look up their own code; the generate_deck function reads them with admin access.
    match /accessCodes/{uid} {
      allow read: if isAdmin();
    }

    // After paying on the Upgrade page, a person records which plan they paid for. The admin checks it
    // against Square and approves it (which changes the plan through admin_update_account) or dismisses it.
    match /upgradeRequests/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid && notSuspended()
        && request.resource.data.keys().hasOnly(["email", "displayName", "plan", "note", "status", "requestedAt"])
        && request.resource.data.plan in ["pro", "promax"]
        && request.resource.data.status == "pending"
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "closedAt"])
        && request.resource.data.status in ["approved", "dismissed"];
    }

    // Payments reported by the Square webhook. Only the admin can see them, and can mark unmatched ones done.
    match /squarePayments/{paymentId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "resolvedAt"])
        && request.resource.data.status == "resolved";
    }

    // Decks built with Claude are written by the generate_deck function (admin access).
    // Reading a deck that doesn't exist yet is allowed, so the app can wait for a new deck to appear.
    match /decks/{deckId} {
      // The owner can also share a deck (through the share_deck function) with other registered users.
      allow get: if resource == null ? signedIn() : (((owns(resource.data) || sharedWithMe(resource.data)) && notSuspended()) || isAdmin());
      allow list: if ((owns(resource.data) || sharedWithMe(resource.data)) && notSuspended()) || isAdmin();
      allow delete: if owns(resource.data);

      match /questions/{questionId} {
        function deck() { return get(/databases/$(database)/documents/decks/$(deckId)).data; }
        allow read: if signedIn() && (deck().ownerId == request.auth.uid || sharedWithMe(deck()) || isAdmin());
      }
    }

    // Review decks: each person's own collections of questions saved from any deck. The app writes them
    // directly. Each question is a copy, so a review deck keeps working after its source deck is gone.
    match /reviewDecks/{deckId} {
      function validName(d) { return d.name is string && d.name.size() >= 1 && d.name.size() <= 60; }
      function validKeys(d) { return d.questionKeys is list && d.questionKeys.size() <= 1000; }
      allow get: if resource == null ? signedIn() : owns(resource.data);
      allow list: if owns(resource.data);
      allow create: if owns(request.resource.data) && notSuspended()
        && request.resource.data.keys().hasOnly(["ownerId", "name", "questionKeys", "createdAt", "updatedAt"])
        && validName(request.resource.data) && validKeys(request.resource.data);
      allow update: if owns(resource.data) && notSuspended()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "questionKeys", "updatedAt"])
        && validName(request.resource.data) && validKeys(request.resource.data);
      allow delete: if owns(resource.data);

      match /questions/{key} {
        function deckBefore() { return get(/databases/$(database)/documents/reviewDecks/$(deckId)); }
        function deckAfter() { return getAfter(/databases/$(database)/documents/reviewDecks/$(deckId)); }
        allow read: if signedIn() && deckBefore().data.ownerId == request.auth.uid;
        // Written in the same batch as the deck, so check the deck as it will be after the write.
        allow create, update: if signedIn() && notSuspended() && deckAfter() != null && deckAfter().data.ownerId == request.auth.uid
          && key in deckAfter().data.questionKeys
          && request.resource.data.prompt is string && request.resource.data.prompt.size() <= 5000
          && request.resource.data.explanation is string && request.resource.data.explanation.size() <= 20000;
        allow delete: if signedIn() && deckBefore().data.ownerId == request.auth.uid;
      }
    }

    // Study notes: one private document per person per lesson, id "{uid}_{lessonId}". Writing needs a paid plan
    // (Study is part of Pro and Pro Max); reading and deleting stay open to the owner, so notes can still be
    // downloaded after a downgrade.
    match /studyNotes/{noteId} {
      function paid() {
        return isAdmin() || (exists(accountPath()) && get(accountPath()).data.plan in ["pro", "promax"]);
      }
      function validNote(d) {
        return d.keys().hasOnly(["ownerId", "lessonId", "text", "confidence", "updatedAt"])
          && d.lessonId is string && d.lessonId.size() >= 1 && d.lessonId.size() <= 60
          && noteId == request.auth.uid + "_" + d.lessonId
          && d.text is string && d.text.size() <= 20000
          && d.confidence in ["", "got", "shaky"]
          && d.updatedAt == request.time;
      }
      allow get: if resource == null ? signedIn() : owns(resource.data);
      allow list: if owns(resource.data);
      allow create, update: if owns(request.resource.data) && notSuspended() && paid() && validNote(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /sessions/{sessionId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) && request.resource.data.status == "active" && notSuspended();
      // A finished session is a record; it can't be reopened or reassigned.
      allow update: if owns(resource.data)
        && resource.data.status == "active"
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.deckId == resource.data.deckId;
    }
  }
}
