rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(data) { return signedIn() && data.ownerId == request.auth.uid; }

    // Questions ship with the app, so only practice sessions are stored.
    match /sessions/{sessionId} {
      allow read: if owns(resource.data);
      allow create: if owns(request.resource.data) && request.resource.data.status == "active";
      // A finished session is a record; it can't be reopened or reassigned.
      allow update: if owns(resource.data)
        && resource.data.status == "active"
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.deckId == resource.data.deckId;
    }
  }
}
